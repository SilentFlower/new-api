{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 .codex/hooks/inject-workflow-state.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 .trellis/scripts/flower_telemetry_hook.py --platform codex",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(?:trellis-implement|trellis-check|trellis-research)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 .codex/hooks/inject-subagent-context.py",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 .trellis/scripts/flower_session_start.py --hook .codex/hooks/session-start.py --part state",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 -X utf8 .trellis/scripts/flower_session_start.py --hook .codex/hooks/session-start.py --part rules",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 -X utf8 .trellis/scripts/flower_session_start.py --hook .codex/hooks/session-start.py --part stages",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 .trellis/scripts/flower_update_hook.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 .trellis/scripts/flower_telemetry_hook.py --platform codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
